{
  "name": "quizquiz",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:env": "node scripts/db-env.mjs",
    "db:up": "docker compose --env-file .env.local up -d --wait db",
    "db:down": "docker compose --env-file .env.local down",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db.mjs seed",
    "db:status": "node --env-file-if-exists=.env.local scripts/db.mjs status",
    "bank": "node --env-file-if-exists=.env.local scripts/bank.mjs",
    "bank:generate": "node --conditions=react-server --env-file-if-exists=.env.local scripts/generate-bank.ts",
    "db:setup": "npm run db:env && npm run db:up && npm run db:migrate && npm run db:seed",
    "test:db": "node --env-file-if-exists=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "docker:up": "docker compose --env-file .env.local --profile app up --build -d --wait",
    "docker:down": "docker compose --env-file .env.local --profile app down",
    "docker:logs": "docker compose --env-file .env.local logs -f app",
    "submissions": "node --conditions=react-server --env-file-if-exists=.env.local scripts/review-submissions.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "next": "16.3.6",
    "openai": "7.23.0",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "typescript": "^5.9.0",
    "vitest": "5.0.2"
  }
}
