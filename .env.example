# mock: fixed sample questions, no network requests or API costs.
# openai: enable Astra after setting your own server-side API key.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# npm run db:env creates random local credentials in .env.local.
# The values below are a matching example, not production credentials.
POSTGRES_PASSWORD=change-me-for-local-dev
DATABASE_URL=postgresql://quizquiz:change-me-for-local-dev@127.0.0.1:5433/quizquiz

# Generated by npm run db:env. Never commit a real auth secret.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
# Docker app uses a separate port; use an HTTPS origin on your deployment host.
DOCKER_APP_URL=http://127.0.0.1:3001
